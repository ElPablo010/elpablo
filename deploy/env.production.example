# Productie-.env voor el-pablo.com (Combell shared hosting).
# Kopieer op de server naar ~/elpablo-new/.env en vul de <...> in.
# Dit bestand bevat GEEN geheimen — de echte .env staat niet in git.

APP_NAME="El Pablo"
APP_ENV=production
APP_KEY=
# CRUCIAAL: op false. Met true lekt elke foutpagina code, paden en .env-waarden.
APP_DEBUG=false
APP_URL=https://el-pablo.com

# Admin-UI + validatie in het Nederlands (zie CLAUDE.md).
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_BE

APP_TIMEZONE=Europe/Brussels

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (paneel -> Databases) ---
DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-naam>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-wachtwoord>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# --- Mail ---
# Combell blokkeert uitgaande SMTP (poort 25/465/587 naar buiten = timeout).
# Mail moet via de lokale Exim. De -bs-modus faalt; gebruik -t -i.
# (Les uit de arkvannoe.be-deploy.)
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
# LET OP: contact- en boekingsformulieren sturen naar config('mail.from.address'),
# dus naar dít adres (zie ContactForm.php). Het is tegelijk afzender en ontvanger.
# Inzendingen worden sowieso in de database bewaard, dus een mailfout verliest
# nooit een lead.
MAIL_FROM_ADDRESS="info@el-pablo.com"
MAIL_FROM_NAME="El Pablo"

VITE_APP_NAME="${APP_NAME}"
